# Define un secreto local aleatorio antes de usar el stack en un entorno real.
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# La API key es opcional para levantar el stack; requerida para usar el agente.
OPENAI_API_KEY=asbcdef
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
